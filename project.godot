[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_game_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_game_template/base/translations/menus_translations.fr.translation")

[maaacks_game_template]

disable_install_wizard=true
main_menu_scene_path="res://Menu/scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://Scenes/Main.tscn"
ending_scene_path="res://Menu/scenes/end_credits/end_credits.tscn"
copy_path="res://Menu/"

[physics]

3d/physics_engine="Jolt Physics"

[plugin_updater]

plugins={
"res://addons/maaacks_game_template/": "https://github.com/Maaack/Godot-Minimal-Game-Template",
"res://addons/plugin_updater/": "https://github.com/Maaack/Godot-Plugin-Updater"
}

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
